{
  "name": "negar-portfolio-assistant",
  "main": "worker.mjs",
  "no_bundle": true,
  "find_additional_modules": true,
  "rules": [{ "type": "ESModule", "globs": ["profile.mjs"] }],
  "compatibility_date": "2026-10-05",
  "workers_dev": true,
  "vars": {
    "ALLOWED_ORIGIN": "https://negarhonarvar.github.io",
    "AI_MODEL": "@cf/meta/llama-3.1-8b-instruct-fp8-fast"
  },
  "ai": { "binding": "AI" },
  "ratelimits": [
    { "name": "VISITOR_LIMIT", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } },
    { "name": "SITE_LIMIT", "namespace_id": "1002", "simple": { "limit": 10, "period": 60 } }
  ],
  "observability": { "enabled": false }
}
